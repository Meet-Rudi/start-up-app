{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WritePlatformRolesOnlyUnderTheBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::949753869755:role/meetrudi-internal-*",
        "arn:aws:iam::949753869755:role/meetrudi-tenant-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::949753869755:policy/meetrudi-boundary"
        }
      }
    },
    {
      "Sid": "ManagePlatformRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::949753869755:role/meetrudi-internal-*",
        "arn:aws:iam::949753869755:role/meetrudi-tenant-*"
      ]
    },
    {
      "Sid": "PassPlatformRolesToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::949753869755:role/meetrudi-internal-*",
        "arn:aws:iam::949753869755:role/meetrudi-tenant-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "events.amazonaws.com",
            "scheduler.amazonaws.com",
            "states.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadTheBoundary",
      "Effect": "Allow",
      "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"],
      "Resource": "arn:aws:iam::949753869755:policy/meetrudi-boundary"
    },
    {
      "Sid": "NeverChangeTheBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::949753869755:policy/meetrudi-boundary"
    },
    {
      "Sid": "NeverRemoveABoundary",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    }
  ]
}
